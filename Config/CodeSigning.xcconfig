// Repository-safe signing defaults. Do not put a real Team ID or certificate
// identity in this tracked file.
// 仓库只保留公开默认值；真实 Team ID 和证书身份不得写入本文件。

CODE_SIGN_STYLE = Automatic
PRODUCT_BUNDLE_IDENTIFIER = com.mdxtom.simnavstudio

// Xcode silently skips this file on a fresh clone. Local developers create it
// with Tools/Signing/setup_local_signing.sh; Git always ignores it.
// 新克隆缺少本机文件时仍可构建 Simulator/unsigned 工件；真机签名由忽略文件注入。
#include? "CodeSigning.local.xcconfig"
